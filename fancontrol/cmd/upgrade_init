#!/bin/bash
# 升级前：停止本应用进程
set -u

PKG_VAR="${TRIM_PKGVAR:-/var/apps/FanControl/var}"
APP_DIR="${TRIM_APPDEST:-/var/apps/FanControl/target}"

for pf in "$PKG_VAR/fand.pid" "$PKG_VAR/web.pid"; do
  if [ -f "$pf" ]; then
    pid="$(cat "$pf" 2>/dev/null)"
    [ -n "$pid" ] && kill "$pid" 2>/dev/null
    rm -f "$pf"
  fi
done
pkill -f "$APP_DIR/server.py" 2>/dev/null
pkill -f "$APP_DIR/fand.py" 2>/dev/null

exit 0
